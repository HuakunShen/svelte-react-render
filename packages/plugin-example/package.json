{
  "name": "@svelte-react-render/plugin-example",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --dev",
    "server:simple": "bun run src/simple-demo.server.ts",
    "server:advanced": "bun run src/advanced-demo.server.ts",
    "server": "concurrently \"bun run server:simple\" \"bun run server:advanced\""
  },
  "dependencies": {
    "@svelte-react-render/api": "workspace:*",
    "kkrpc": "^0.4.0",
    "react": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.18",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "serve": "^14.2.5",
    "typescript": "^5"
  }
}
